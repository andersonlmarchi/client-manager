# Copy to .env (never commit .env) before starting Compose:
#   cp .env.example .env
#
# Generate a strong password, e.g.:
#   openssl rand -base64 32

POSTGRES_USER=clientmanager
POSTGRES_PASSWORD=change-me-to-a-long-random-secret
POSTGRES_DB=clientmanager
POSTGRES_PORT=5432
CONFIGURATION_PORT=8081
IDENTITY_PORT=8082
LOG_LEVEL=info
ADMIN_API_KEY=change-me-admin-api-key
